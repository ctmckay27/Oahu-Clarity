diff --git a/qwen_tts_talker.c b/qwen_tts_talker.c
index 3b49880..8e96f9e 100644
--- a/qwen_tts_talker.c
+++ b/qwen_tts_talker.c
@@ -18,6 +18,7 @@
 #define QWEN_HAVE_MADVISE 1
 #endif
 
+static FILE *g_mari_seq = NULL;
 static const char *g_actmap_path   = NULL;
 static double    **g_actmap_acc    = NULL;
 static int         g_actmap_layers = 0;
@@ -26,6 +27,7 @@ static long        g_actmap_frames = 0;
 static int         g_actmap_probed = 0;
 
 static void actmap_dump(void) {
+    if(g_mari_seq){int failed=fflush(g_mari_seq)!=0 || ferror(g_mari_seq); if(fclose(g_mari_seq)!=0)failed=1; g_mari_seq=NULL; if(failed){perror("MARI capture flush");_Exit(72);}}
     if (!g_actmap_path || g_actmap_frames <= 0 || !g_actmap_acc) return;
